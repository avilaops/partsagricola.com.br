{
  "name": "@partsagricola/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=4100 tsx watch src/server.ts",
    "generate:openapi": "tsx src/generate-openapi.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "PORT=4100 node dist/server.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/catalog/*.test.ts src/chat/*.test.ts src/moderation/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/websocket": "^11.3.4",
    "@partsagricola/config": "workspace:*",
    "@partsagricola/db": "workspace:*",
    "@partsagricola/providers": "workspace:*",
    "@partsagricola/shared": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "^4.0.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "ws": "^8.22.0"
  }
}
