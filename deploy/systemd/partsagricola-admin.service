[Unit]
Description=PartsAgricola administration
After=network-online.target partsagricola-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/partsagricola-marketplace/current/admin
EnvironmentFile=/opt/partsagricola-marketplace/shared/.env.admin
ExecStart=/usr/bin/node apps/admin/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
